{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://district.edu/schemas/education-data-contract-v1.json",
  "title": "Education Data Contract Schema",
  "description": "Schema for validating education sector data contracts with FERPA compliance",
  "type": "object",
  "required": ["contract"],
  "properties": {
    "contract": {
      "type": "object",
      "required": ["id", "version", "producer", "schema", "sla", "governance"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+_v[0-9]+$",
          "description": "Unique contract identifier with version suffix"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Semantic version (MAJOR.MINOR.PATCH)"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "review", "approved", "active", "deprecated", "retired"],
          "default": "draft"
        },
        "type": {
          "type": "string",
          "enum": ["data", "product", "golden_record"],
          "default": "data",
          "description": "Contract type: data (source), product (semantic), or golden_record (MDM)"
        },
        "producer": {
          "type": "object",
          "required": ["system", "team", "owner"],
          "properties": {
            "system": {
              "type": "string",
              "description": "Source system identifier (e.g., STUDENT_INFORMATION_SYSTEM)"
            },
            "team": {
              "type": "string",
              "description": "Owning team name"
            },
            "owner": {
              "type": "string",
              "format": "email",
              "description": "Team contact email"
            },
            "slack_channel": {
              "type": "string",
              "pattern": "^#[a-z0-9-]+$"
            }
          }
        },
        "schema": {
          "type": "object",
          "required": ["database", "schema", "table", "columns"],
          "properties": {
            "database": {
              "type": "string",
              "description": "Target database (supports ${ENV} substitution)"
            },
            "schema": {
              "type": "string",
              "description": "Target schema"
            },
            "table": {
              "type": "string",
              "description": "Target table name"
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/column"
              }
            }
          }
        },
        "output": {
          "type": "object",
          "description": "Output specification for product contracts",
          "properties": {
            "database": { "type": "string" },
            "schema": { "type": "string" },
            "semantic_view": { "type": "string" },
            "description": { "type": "string" },
            "dimensions": {
              "type": "array",
              "items": { "$ref": "#/definitions/dimension" }
            },
            "metrics": {
              "type": "array",
              "items": { "$ref": "#/definitions/metric" }
            },
            "sample_questions": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "sla": {
          "type": "object",
          "properties": {
            "freshness": {
              "type": "object",
              "properties": {
                "max_age_minutes": {
                  "type": "integer",
                  "minimum": 1
                },
                "measurement": {
                  "type": "string"
                }
              }
            },
            "completeness": {
              "type": "object",
              "properties": {
                "threshold_percent": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "critical_columns": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "availability": {
              "type": "object",
              "properties": {
                "uptime_percent": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "maintenance_window": {
                  "type": "string"
                }
              }
            },
            "volume": {
              "type": "object",
              "properties": {
                "expected_daily_rows": {
                  "type": "object",
                  "properties": {
                    "min": { "type": "integer" },
                    "max": { "type": "integer" }
                  }
                },
                "alert_on_variance_percent": {
                  "type": "number"
                }
              }
            },
            "query_performance": {
              "type": "object",
              "properties": {
                "p95_seconds": { "type": "number" },
                "max_seconds": { "type": "number" }
              }
            }
          }
        },
        "quality_rules": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/quality_rule"
          }
        },
        "governance": {
          "type": "object",
          "required": ["classification", "ai_eligibility"],
          "properties": {
            "classification": {
              "type": "string",
              "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]
            },
            "residency_requirements": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "retention_days": {
              "type": "integer",
              "minimum": 1
            },
            "ai_eligibility": {
              "type": "string",
              "enum": ["TRUE", "FALSE", "PSEUDONYMIZED_ONLY", "AGGREGATED_ONLY"]
            },
            "compliance_frameworks": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["FERPA", "COPPA", "HIPAA", "State_Privacy_Laws", "GDPR"]
              },
              "description": "Applicable compliance frameworks"
            },
            "access_controls": {
              "type": "object",
              "properties": {
                "masking_policies": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/masking_policy" }
                },
                "row_access_policies": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/row_access_policy" }
                }
              }
            },
            "allowed_roles": {
              "type": "array",
              "items": { "type": "string" }
            },
            "prohibited_uses": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "lineage": {
          "type": "object",
          "properties": {
            "source_systems": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "connection": { "type": "string" },
                  "extraction": { 
                    "type": "string",
                    "enum": ["FULL_REFRESH", "CDC_STREAM", "INCREMENTAL", "DIRECT_LOAD"]
                  }
                }
              }
            },
            "source_contracts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "contract_id": { "type": "string" },
                  "type": { "type": "string" }
                }
              }
            },
            "downstream_dependencies": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "contract_id": { "type": "string" },
                  "type": { "type": "string" }
                }
              }
            },
            "transformations": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "consumers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/consumer"
          }
        }
      }
    }
  },
  "definitions": {
    "column": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        },
        "type": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["not_null", "unique", "primary_key", "foreign_key"]
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { 
                "type": "string",
                "enum": ["accepted_values", "range", "format", "pattern"]
              },
              "values": { 
                "type": "array",
                "items": { "type": "string" }
              },
              "pattern": { "type": "string" },
              "min": { "type": ["number", "string"] },
              "max": { "type": ["number", "string"] }
            }
          }
        },
        "tags": {
          "type": "object",
          "properties": {
            "DATA_CLASSIFICATION": {
              "type": "string",
              "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]
            },
            "PII_TYPE": {
              "type": "string",
              "enum": ["NONE", "LOW", "MODERATE", "HIGH"]
            },
            "AI_ALLOWED": {
              "type": "string",
              "enum": ["TRUE", "FALSE", "PSEUDONYMIZED_ONLY", "AGGREGATED_ONLY"]
            },
            "RESIDENCY_REGION": {
              "type": "string",
              "enum": ["GLOBAL", "ORIGIN", "EU_ONLY", "US_ONLY"]
            },
            "FERPA_CATEGORY": {
              "type": "string",
              "enum": ["DIRECTORY", "EDUCATIONAL_RECORD", "SENSITIVE", "HEALTH"],
              "description": "FERPA data category for education-specific classification"
            }
          },
          "required": ["DATA_CLASSIFICATION", "PII_TYPE", "AI_ALLOWED"]
        },
        "system_managed": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "dimension": {
      "type": "object",
      "required": ["name", "type", "description"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "description": { "type": "string" },
        "synonyms": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "metric": {
      "type": "object",
      "required": ["name", "type", "description", "sql"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "description": { "type": "string" },
        "sql": { "type": "string" },
        "synonyms": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "quality_rule": {
      "type": "object",
      "required": ["id", "name", "type", "sql", "severity"],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": ["column_check", "table_check", "cross_table_check"]
        },
        "column": {
          "type": "string"
        },
        "sql": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": ["error", "warning", "info"]
        }
      }
    },
    "consumer": {
      "type": "object",
      "required": ["team", "contact", "use_case", "access_level"],
      "properties": {
        "team": {
          "type": "string"
        },
        "contact": {
          "type": "string",
          "format": "email"
        },
        "use_case": {
          "type": "string"
        },
        "access_level": {
          "type": "string",
          "enum": ["read_full", "read_masked", "read_aggregated"]
        }
      }
    },
    "masking_policy": {
      "type": "object",
      "required": ["column", "policy"],
      "properties": {
        "column": { "type": "string" },
        "policy": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "row_access_policy": {
      "type": "object",
      "required": ["policy"],
      "properties": {
        "policy": { "type": "string" },
        "description": { "type": "string" }
      }
    }
  }
}
